# Copy to .env (never committed). The scaffold skill writes one per app with only the vars that app needs.

# --- apps/api (local: .dev.vars) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=            # from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=    # from `supabase status`; server-side only, NEVER ship to web/mobile
ENVIRONMENT=local

# --- apps/web (.env.local; Vite exposes only VITE_* to the browser) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8787

# --- apps/site (.env; Astro exposes only PUBLIC_*) ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:5173

# --- apps/mobile (.env; Expo exposes only EXPO_PUBLIC_*) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
